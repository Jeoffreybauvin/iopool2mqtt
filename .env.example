# =============================================================================
# iopool2mqtt - Example Configuration (.env.example)
# Copy this file to `.env` and fill in your `IOPOOL_API_KEY`.
# All variables can be overridden via environment variables at runtime.
# =============================================================================

# --- iopool API Configuration ---
IOPOOL_API_KEY=your_iopool_api_key_here
IOPOOL_API_URL=https://api.iopool.com/v1
IOPOOL_POOL_IDS=
IOPOOL_HTTP_TIMEOUT_SECS=15

# --- MQTT Broker Configuration ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=iopool2mqtt
MQTT_BASE_TOPIC=iopool2mqtt
MQTT_USE_POOL_TITLE=false
MQTT_QOS=1
MQTT_RETAIN=true
MQTT_KEEP_ALIVE_SECS=30

# --- Home Assistant MQTT Auto-Discovery ---
HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant

# --- Runtime & Logging ---
POLL_INTERVAL_SECS=300
RUN_ONCE=false
RUST_LOG=info,iopool2mqtt=info
